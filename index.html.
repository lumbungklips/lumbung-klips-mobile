<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0c1422">
<title>LUMBUNG KLIPS — Video Clipping Studio</title>
<style>
:root{--bg:#0c1422;--panel:#152238;--panel2:#1c2d46;--line:#2b405e;--mint:#68e0b5;--gold:#f0c66b;--text:#f3f7fc;--muted:#a9b8cc;--red:#ff9b9b}
*{box-sizing:border-box}
body{margin:0;background:linear-gradient(180deg,#101d31,#0c1422 38%);color:var(--text);font-family:Arial,sans-serif}
header{padding:22px 17px 18px;background:#14243a;border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:12px}
.logo{width:46px;height:46px;border-radius:13px;background:#061422;border:1px solid #3b5876;display:grid;place-items:center;color:var(--mint);font-weight:900;letter-spacing:1px}
h1{font-size:21px;letter-spacing:3px;margin:0;color:var(--mint)}
header p{margin:6px 0 0;color:var(--muted);font-size:12px}
main{max-width:760px;margin:auto;padding:13px 14px 32px}
.notice{border:1px solid #66552d;background:#302a1c;color:#f6e5b6;border-radius:13px;padding:12px;font-size:12px;line-height:1.5}
nav{display:flex;gap:7px;overflow:auto;padding:13px 0;position:sticky;top:0;background:#0c1422;z-index:5}
button{border:0;border-radius:10px;padding:11px 13px;background:var(--mint);color:#09251c;font-weight:700;font-size:13px;white-space:nowrap}
button.secondary{background:#2b405e;color:#f3f7fc}
button:disabled{opacity:.5}
section{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:15px;margin:12px 0;scroll-margin-top:75px}
h2{font-size:17px;color:var(--mint);margin:0 0 12px}
h3{font-size:14px;margin:15px 0 7px;color:#dce8f6}
p{line-height:1.5}
.muted,small{color:var(--muted)}
.stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.stat{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:12px;font-size:12px;color:var(--muted)}
.stat strong{display:block;color:var(--text);font-size:18px;margin-top:7px}
.status{display:inline-block;border-radius:30px;padding:4px 9px;font-size:11px;background:#493d22;color:#f6e5b6}
.status.ok{background:#163d34;color:#a8f3d8}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.tile{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:12px}
.tile b{display:block;margin-bottom:5px;font-size:13px}
.tile span{font-size:11px;color:var(--muted);line-height:1.4}
label{display:block;font-size:12px;color:#c8d5e6;margin:12px 0 6px}
input,textarea,select{width:100%;padding:12px;border-radius:9px;border:1px solid #526780;background:#0d192a;color:white;font-size:14px}
textarea{min-height:90px;resize:vertical}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.output{white-space:pre-wrap;background:#0d192a;border:1px solid var(--line);padding:12px;border-radius:10px;margin-top:12px;line-height:1.5;font-size:13px}
.file{padding:11px 0;border-bottom:1px solid var(--line);font-size:13px;overflow-wrap:anywhere}
.file:last-child{border:0}
.file a{color:var(--mint)}
footer{text-align:center;padding:20px;color:#8193aa;font-size:11px}
@media(max-width:420px){.grid{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr)}}
</style>
</head>
<body>
<header><div class="brand"><div class="logo">LK</div><div><h1>LUMBUNG KLIPS</h1><p>AI VIDEO CLIPPING STUDIO · MODE PERINTAH</p></div></div></header>
<main>
<div class="notice"><b>STATUS STUDIO</b><br>Dashboard ini dapat memeriksa daftar materi di Google Drive jika koneksi backend dan izin Google sudah selesai. Pembuatan/render video 15–20 detik dan pemantauan TikTok otomatis belum aktif. Jangan masukkan password, OTP, atau token Google ke kolom dashboard.</div>
<nav>
<button onclick="go('dashboard')">Dashboard</button>
<button class="secondary" onclick="go('drive')">Google Drive</button>
<button class="secondary" onclick="go('clip')">Video Clipper</button>
<button class="secondary" onclick="go('caption')">Caption</button>
<button class="secondary" onclick="go('monitor')">TikTok</button>
</nav>
<section id="dashboard">
<h2>Pusat Kendali Video</h2>
<p>Selamat datang di ruang kerja LUMBUNG KLIPS. Pilih materi dari folder Drive, lalu siapkan konsep klip pendek untuk diproses.</p>
<div class="stats">
<div class="stat">Materi di Drive<strong id="fileCount">Belum dicek</strong></div>
<div class="stat">Klip selesai<strong>0</strong></div>
<div class="stat">Durasi target<strong>15–20 detik</strong></div>
<div class="stat">Status Google Drive<strong id="driveStatus">Belum diuji</strong></div>
</div>
<div class="grid" style="margin-top:10px">
<div class="tile"><b>1. Materi</b><span>Ambil daftar video dari folder Google Drive milik Anda.</span></div>
<div class="tile"><b>2. Konsep klip</b><span>Tentukan hook, bagian utama, dan ajakan bertindak.</span></div>
<div class="tile"><b>3. Penyuntingan</b><span>Render video dan subtitle otomatis belum tersedia.</span></div>
<div class="tile"><b>4. Publikasi</b><span>Video diposting manual ke TikTok oleh Anda.</span></div>
</div>
</section>
<section id="drive">
<h2>Google Drive</h2>
<p class="muted">Folder tujuan: <b>LUMBUNG KLIPS - MATERI VIDEO</b></p>
<p class="muted">Tekan tombol di bawah untuk memeriksa materi. Jika izin Google belum selesai, dashboard akan menampilkan pesan kesalahan dari backend.</p>
<div class="actions"><button id="connectBtn" onclick="connectDrive()">Hubungkan / Beri Izin Google Drive</button><button class="secondary" id="refreshBtn" onclick="loadDrive()">Periksa Materi Drive</button></div>
<div id="driveMessage" class="output">Status: belum diperiksa.</div>
<div id="fileList"></div>
</section>
<section id="clip">
<h2>Video Clipper — Rencana Klip</h2>
<p class="muted">Bagian ini membantu menyusun arahan klip. Ini belum memotong atau mengekspor file video.</p>
<label for="sourceTitle">Nama materi / topik video</label><input id="sourceTitle" placeholder="Contoh: Tips merapikan dapur">
<label for="hook">Hook pembuka (0–3 detik)</label><textarea id="hook" placeholder="Kalimat yang membuat penonton berhenti scroll..."></textarea>
<label for="mainPoint">Isi utama (3–16 detik)</label><textarea id="mainPoint" placeholder="Poin terpenting dari video..."></textarea>
<label for="cta">Ajakan (16–20 detik)</label><input id="cta" placeholder="Contoh: Simpan video ini untuk dicoba nanti">
<div class="actions"><button onclick="makePlan()">Susun Rencana Klip</button><button class="secondary" onclick="copyPlan()">Salin Rencana</button></div>
<div id="clipOutput" class="output">Rencana klip akan tampil di sini.</div>
</section>
<section id="caption">
<h2>Caption & Deskripsi</h2>
<label for="captionTopic">Topik video</label><input id="captionTopic" placeholder="Masukkan topik video">
<label for="captionTone">Gaya caption</label><select id="captionTone"><option value="Santai dan menarik">Santai dan menarik</option><option value="Informatif">Informatif</option><option value="Persuasif">Persuasif</option></select>
<div class="actions"><button onclick="makeCaption()">Buat Draf Caption</button><button class="secondary" onclick="copyCaption()">Salin Caption</button></div>
<div id="captionOutput" class="output">Draf caption akan tampil di sini.</div>
</section>
<section id="monitor">
<h2>Pemantauan TikTok</h2>
<p>Belum terhubung ke akun TikTok dan belum mengambil data tayangan, suka, komentar, atau pengikut.</p>
<label for="views">Tayangan (isi manual)</label><input id="views" type="number" min="0" placeholder="0">
<label for="likes">Suka</label><input id="likes" type="number" min="0" placeholder="0">
<label for="comments">Komentar</label><input id="comments" type="number" min="0" placeholder="0">
<div class="actions"><button onclick="saveMetrics()">Simpan Catatan Angka</button></div>
<div id="metricsOutput" class="output">Belum ada catatan.</div>
</section>
<footer>LUMBUNG KLIPS · Video Studio · Data formulir disimpan di browser perangkat ini.</footer>
</main>
<script>
const API='/ .netlify/functions/drive'.replace('/ ','/');
function go(id){document.getElementById(id).scrollIntoView({behavior:'smooth'});}
function setDriveStatus(text,ok=false){const el=document.getElementById('driveStatus');el.textContent=text;el.className=ok?'status ok':'status';}
function connectDrive(){location.href=API+'?action=auth';}
async function loadDrive(){
 const msg=document.getElementById('driveMessage'),list=document.getElementById('fileList'),btn=document.getElementById('refreshBtn');
 msg.textContent='Sedang memeriksa folder Google Drive...';list.innerHTML='';btn.disabled=true;
 try{
  const r=await fetch(API+'?action=list',{cache:'no-store'});const data=await r.json();
  if(!r.ok)throw new Error(data.error||'Koneksi Drive belum berhasil.');
  const files=Array.isArray(data.files)?data.files:[];
  document.getElementById('fileCount').textContent=String(files.length);
  setDriveStatus('Terhubung',true);
  msg.textContent=files.length?`Berhasil membaca folder. Ditemukan ${files.length} file.`:'Berhasil terhubung, tetapi folder belum berisi file.';
  list.innerHTML=files.map(f=>`<div class="file"><b>${escapeHtml(f.name||'Tanpa nama')}</b><br><small>${escapeHtml(f.mimeType||'Jenis file tidak diketahui')}</small>${f.webViewLink?`<br><a href="${safeUrl(f.webViewLink)}" target="_blank" rel="noopener">Buka di Google Drive</a>`:''}</div>`).join('');
 }catch(e){document.getElementById('fileCount').textContent='—';setDriveStatus('Belum terhubung');msg.textContent='Belum berhasil: '+e.message+' Pastikan konfigurasi Netlify dan izin Google sudah benar.';}
 finally{btn.disabled=false;}
}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function safeUrl(s){try{const u=new URL(s);return u.protocol==='https:'?u.href:'#';}catch{return '#';}}
function makePlan(){
 const title=document.getElementById('sourceTitle').value.trim()||'Materi video';
 const hook=document.getElementById('hook').value.trim()||'[Tulis hook singkat]';
 const main=document.getElementById('mainPoint').value.trim()||'[Pilih inti informasi paling penting]';
 const cta=document.getElementById('cta').value.trim()||'[Tambahkan ajakan]';
 const out=`RENCANA KLIP: ${title}\n\n00:00–00:03 | HOOK\n${hook}\n\n00:03–00:16 | ISI UTAMA\n${main}\n\n00:16–00:20 | AJAKAN\n${cta}\n\nCatatan: ini naskah/rencana edit, bukan file video hasil render.`;
 document.getElementById('clipOutput').textContent=out;localStorage.setItem('lk_clip_plan',out);
}
function makeCaption(){
 const topic=document.getElementById('captionTopic').value.trim()||'video ini';
 const tone=document.getElementById('captionTone').value;
 const out=`${topic} — ${tone.toLowerCase()}.\n\nTonton sampai selesai dan beri tahu pendapatmu di komentar!\n\n#LumbungKlips #TipsVideo #KontenKreator`;
 document.getElementById('captionOutput').textContent=out;localStorage.setItem('lk_caption',out);
}
function copyText(id){const t=document.getElementById(id).textContent;if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(t).then(()=>alert('Teks berhasil disalin.')).catch(()=>alert('Tidak dapat menyalin otomatis. Silakan pilih dan salin teks.'));}else{alert('Silakan pilih dan salin teks secara manual.');}}
function copyPlan(){copyText('clipOutput')}function copyCaption(){copyText('captionOutput')}
function saveMetrics(){
 const data={views:Number(document.getElementById('views').value||0),likes:Number(document.getElementById('likes').value||0),comments:Number(document.getElementById('comments').value||0),savedAt:new Date().toLocaleString('id-ID')};
 localStorage.setItem('lk_tiktok_metrics',JSON.stringify(data));
 document.getElementById('metricsOutput').textContent=`Catatan manual tersimpan di perangkat ini.\nTayangan: ${data.views}\nSuka: ${data.likes}\nKomentar: ${data.comments}\nWaktu catat: ${data.savedAt}`;
}
(function restore(){const p=localStorage.getItem('lk_clip_plan');if(p)document.getElementById('clipOutput').textContent=p;const c=localStorage.getItem('lk_caption');if(c)document.getElementById('captionOutput').textContent=c;const m=localStorage.getItem('lk_tiktok_metrics');if(m){try{const d=JSON.parse(m);document.getElementById('metricsOutput').textContent=`Catatan manual tersimpan di perangkat ini.\nTayangan: ${d.views}\nSuka: ${d.likes}\nKomentar: ${d.comments}\nWaktu catat: ${d.savedAt}`;}catch{}}})();
</script>
</body>
</html>